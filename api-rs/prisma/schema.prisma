// Connection URL lives in prisma.config.ts (CLI/migrate) and is passed to
// PrismaClient via a driver adapter by prisma/seed.ts — Prisma ORM 7 no longer
// reads `url` from this block.
datasource db {
  provider = "postgresql"
}

// Only the seed script consumes this client; api-rs itself reads Postgres
// through sqlx. `generated/` is gitignored, so run `pnpm db:generate` before
// `pnpm db:seed`.
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Float, not Decimal — keeps JSON serialization trivial for this MVP.
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())

  // Backs the list query's ORDER BY ("createdAt" ASC, "id" ASC). Without it
  // every page sorts the whole table before LIMIT applies. The tuple matches
  // the ordering exactly, so Postgres walks the index and stops at the limit.
  @@index([createdAt, id])
}
