DATABASE_URL="postgresql://rnw:rnw@localhost:5432/rnw_dev"
# Optional read replica. Product reads use it; /health keeps pinging the
# primary. Unset (or unreachable) means every query goes to the primary.
# DATABASE_READ_URL="postgresql://rnw:rnw@localhost:5433/rnw_dev"
VALKEY_URL="redis://localhost:6379"
# 3001 is the contract port every client defaults to; Grafana keeps 3002.
PORT=3001

DB_MAX_CONNECTIONS=10
# A separate budget from DB_MAX_CONNECTIONS: both are per-pool, so they add up
# against Postgres when both point at the same server.
DB_READ_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_MS=2000
REQUEST_TIMEOUT_MS=10000
L1_LIST_TTL_SECS=5
L1_DETAIL_TTL_SECS=60
L2_TTL_SECS=60
GLOBAL_CONCURRENCY_LIMIT=1024
PER_IP_CONCURRENCY_LIMIT=64
RATE_LIMIT_GLOBAL_RPS=0
RATE_LIMIT_PER_IP_RPS=100
# Login/registration attempts per client IP per minute, on its own 60s window.
# Bounds a password-guess rate rather than a traffic burst; fail-open without
# Valkey.
AUTH_LOGIN_ATTEMPTS_PER_MIN=10
# How long a session token stays valid. Logout revokes immediately; this is the
# backstop for a token nobody revoked.
SESSION_TTL_SECS=604800
EDGE_CACHE_CONTROL="public, max-age=0, s-maxage=30, stale-while-revalidate=60"
CORS_ORIGIN="http://localhost:3000"
HEALTH_PING_TIMEOUT_MS=1000
RUST_LOG=info,sqlx=warn

# Enable with `cargo run --features otlp`; defaults to localhost:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# OTEL_TRACES_SAMPLE_RATIO=0.1
