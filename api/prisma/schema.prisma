// Connection URL lives in prisma.config.ts (CLI/migrate) and is passed to
// PrismaClient via a driver adapter at runtime (src/prisma/prisma.service.ts)
// — Prisma ORM 7 no longer reads `url` from this block.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Float, not Decimal — keeps JSON serialization trivial for this MVP.
  price       Float
  currency    String   @default("USD")
  imageUrl    String?
  createdAt   DateTime @default(now())
}
