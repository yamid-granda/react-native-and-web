{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "api#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "api-rs#build": {
      "dependsOn": [],
      "outputs": ["target/release/api-rs"]
    },
    "api-rs#test": {
      "dependsOn": [],
      "outputs": []
    },
    "api-rs#test:e2e": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    },
    "api-rs#bench": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    },
    "api-rs#coverage": {
      "dependsOn": [],
      "outputs": ["lcov.info"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    }
  }
}
