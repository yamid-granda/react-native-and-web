# Optional override. Without it, src/api/client.ts auto-detects the dev
# machine's address from Metro's own connection info (Constants.expoConfig.
# hostUri), which works for the iOS simulator, Android emulator, and a
# physical device via Expo Go alike. Set this only to point at a different
# api instance (e.g. a deployed one).
# EXPO_PUBLIC_API_URL=http://localhost:3001
