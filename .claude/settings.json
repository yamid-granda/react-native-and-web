{
  "outputStyle": "Concise",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-plan-mode-gate.sh"
          }
        ]
      }
    ]
  }
}
