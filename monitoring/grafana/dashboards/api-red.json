{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_requests_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_requests_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}",
          "refId": "B"
        }
      ],
      "title": "Request duration p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_l1_hits_total[5m])) / clamp_min(sum(rate(cache_l1_hits_total[5m])) + sum(rate(cache_l1_misses_total[5m])), 0.001)",
          "legendFormat": "L1 hit ratio",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_l2_hits_total[5m])) / clamp_min(sum(rate(cache_l2_hits_total[5m])) + sum(rate(cache_l2_misses_total[5m])), 0.001)",
          "legendFormat": "L2 hit ratio",
          "refId": "B"
        }
      ],
      "title": "Cache hit ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sqlx_pool_acquire_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        { "expr": "sqlx_pool_size - sqlx_pool_idle", "legendFormat": "in use", "refId": "B" }
      ],
      "title": "SQLx pool acquisition / connections in use",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" }],
      "title": "Process RSS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (scope) (rate(http_rate_limited_total[1m]))",
          "legendFormat": "429 {{scope}}",
          "refId": "B"
        },
        {
          "expr": "sum by (scope) (rate(http_load_shed_total[1m]))",
          "legendFormat": "shed {{scope}}",
          "refId": "C"
        }
      ],
      "title": "Errors, rate limits, and shed requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(cache_l2_errors_total[1m]))",
          "legendFormat": "Valkey {{op}} errors",
          "refId": "A"
        },
        {
          "expr": "sum by (op) (rate(rate_limit_errors_total[1m]))",
          "legendFormat": "rate-limit {{op}} errors",
          "refId": "B"
        }
      ],
      "title": "Cache failures (service fails open)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["api-rs", "RED"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Marketplace API — RED",
  "uid": "api-rs-red",
  "version": 1
}
