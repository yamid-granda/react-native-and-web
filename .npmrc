auto-install-peers=true
strict-peer-dependencies=false

# Metro (mobile-application) doesn't reliably walk pnpm's strict, symlinked
# node_modules to find transitive deps of transitive deps (e.g.
# react-native-css-interop, a dependency of nativewind) — hoisting avoids
# that class of resolution failure. Trades away pnpm's strict isolation for
# broad RN/Metro tooling compatibility, the standard tradeoff for pnpm +
# Expo/Metro monorepos.
node-linker=hoisted
