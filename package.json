{
  "name": "react-native-and-web",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e:web": "turbo run test:e2e --filter=@rnw/web-application",
    "test:e2e:mobile": "turbo run test:e2e --filter=@rnw/mobile-application",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "catalog:",
    "turbo": "^2.11.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.20.0"
  }
}
