{
  "name": "react-native-and-web",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e:web": "turbo run test:e2e --filter=@rnw/web-application",
    "test:e2e:mobile": "turbo run test:e2e --filter=@rnw/mobile-application",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.0",
    "typescript": "catalog:"
  }
}
